{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "useDefineForClassFields": false,
    "outDir": "./dist"
  },
  "include": [
    "features/**/*.ts",
    "step-definitions/**/*.ts",
    "support/**/*.ts",
    "hooks/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}